<script>
/* =====================================================================
   ★ SKILLS — EDIT ME ★
   { name:"Skill", group:"Category", level:0–100, tag:"small label" }
===================================================================== */
const SKILLS = [
  {name:"Log analysis & anomaly detection", group:"Cybersecurity", level:90, tag:"thesis-proven"},
  {name:"Vulnerability assessment", group:"Cybersecurity", level:78, tag:"research"},
  {name:"SIEM concepts & risk management", group:"Cybersecurity", level:72, tag:"google cert"},
  {name:"OWASP Top 10 · NIST AI RMF", group:"Cybersecurity", level:70, tag:"frameworks"},
  {name:"Network security · TCP/IP", group:"Cybersecurity", level:68, tag:"wireshark basics"},
  {name:"Python (scikit-learn, pandas)", group:"Programming", level:85, tag:"daily driver"},
  {name:"SQL", group:"Programming", level:72, tag:"google cert"},
  {name:"HTML / CSS / JavaScript", group:"Programming", level:70, tag:"client sites"},
  {name:"C++ (basics)", group:"Programming", level:55, tag:"codecademy"},
  {name:"LLM prompt engineering", group:"AI & ML", level:88, tag:"0-shot → CoT"},
  {name:"Hallucination & consistency analysis", group:"AI & ML", level:82, tag:"thesis"},
  {name:"TF-IDF & logistic regression", group:"AI & ML", level:80, tag:"93.58% F1"},
  {name:"LLM API integration", group:"AI & ML", level:84, tag:"openrouter · cerebras"},
  {name:"Linux (Ubuntu / CLI)", group:"Tools", level:80, tag:"hardening lab"},
  {name:"Git / GitHub", group:"Tools", level:78, tag:"version control"},
  {name:"n8n automation", group:"Tools", level:76, tag:"kidcafebot · resellos"},
  {name:"Shopify & Vercel deployment", group:"Tools", level:70, tag:"taraai stack"},
  {name:"LaTeX", group:"Tools", level:75, tag:"thesis"},
];
/* ================== end editable block ================== */

const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
const fine=matchMedia('(pointer:fine)').matches;

/* ---------- gold dust — the luxury "rain" ---------- */
(function(){
  const c=document.getElementById('dust'),x=c.getContext('2d');
  let W,H;const N=innerWidth<700?40:90;const ps=[];
  function size(){W=c.width=innerWidth;H=c.height=innerHeight;}
  size();addEventListener('resize',size);
  for(let i=0;i<N;i++)ps.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.6+0.4,vy:Math.random()*0.35+0.08,vx:(Math.random()-.5)*0.12,tw:Math.random()*Math.PI*2});
  function frame(){
    x.clearRect(0,0,W,H);
    for(const p of ps){
      p.y+=p.vy;p.x+=p.vx;p.tw+=0.025;
      if(p.y>H+4){p.y=-4;p.x=Math.random()*W;}
      if(p.x<-4)p.x=W+4;if(p.x>W+4)p.x=-4;
      const a=0.18+Math.abs(Math.sin(p.tw))*0.5;
      x.beginPath();x.arc(p.x,p.y,p.r,0,7);
      x.fillStyle=`rgba(201,169,106,${a})`;
      x.shadowColor='rgba(201,169,106,.8)';x.shadowBlur=p.r*4;
      x.fill();x.shadowBlur=0;
    }
    requestAnimationFrame(frame);
  }
  if(!reduced)frame();
})();

/* ---------- cursor-reactive constellation ---------- */
(function(){
  const c=document.getElementById('net'),x=c.getContext('2d');
  let W,H;const N=innerWidth<700?26:52;const pts=[];const m={x:-999,y:-999};
  function size(){W=c.width=innerWidth;H=c.height=innerHeight;}
  size();addEventListener('resize',size);
  for(let i=0;i<N;i++)pts.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3});
  addEventListener('pointermove',e=>{m.x=e.clientX;m.y=e.clientY;});
  addEventListener('pointerleave',()=>{m.x=-999;m.y=-999;});
  function frame(){
    x.clearRect(0,0,W,H);
    for(const p of pts){
      const dx=p.x-m.x,dy=p.y-m.y,d=Math.hypot(dx,dy)||1;
      if(d<150){const f=(150-d)/150*0.55;p.vx+=dx/d*f;p.vy+=dy/d*f;}
      p.vx*=0.96;p.vy*=0.96;
      if(Math.abs(p.vx)<0.1)p.vx+=(Math.random()-.5)*.05;
      if(Math.abs(p.vy)<0.1)p.vy+=(Math.random()-.5)*.05;
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1;
      p.x=Math.max(0,Math.min(W,p.x));p.y=Math.max(0,Math.min(H,p.y));
    }
    for(let i=0;i<N;i++)for(let j=i+1;j<N;j++){
      const a=pts[i],b=pts[j],d=Math.hypot(a.x-b.x,a.y-b.y);
      if(d<130){x.strokeStyle=`rgba(201,169,106,${(1-d/130)*.16})`;x.lineWidth=0.6;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke();}
    }
    for(const p of pts){x.fillStyle='rgba(237,234,227,.55)';x.fillRect(p.x-0.8,p.y-0.8,1.6,1.6);}
    requestAnimationFrame(frame);
  }
  if(!reduced)frame();
})();

/* ---------- 3D tilt hero ---------- */
(function(){
  if(reduced||!fine)return;
  const g=document.getElementById('tilt'),card=document.getElementById('tiltCard');
  let tx=0,ty=0,cx=0,cy=0;
  addEventListener('pointermove',e=>{tx=(e.clientY/innerHeight-0.5)*-5;ty=(e.clientX/innerWidth-0.5)*7;});
  (function lerp(){cx+=(tx-cx)*0.07;cy+=(ty-cy)*0.07;
    card.style.transform=`rotateX(${cx}deg) rotateY(${cy}deg) translateZ(20px)`;
    g.style.transform=`rotateX(${cx*0.2}deg) rotateY(${cy*0.2}deg)`;
    requestAnimationFrame(lerp);})();
})();

/* ---------- magnetic buttons ---------- */
(function(){
  if(reduced||!fine)return;
  document.querySelectorAll('.btn-g,.mail').forEach(b=>{
    b.addEventListener('pointermove',e=>{
      const r=b.getBoundingClientRect();
      b.style.transform=`translate(${(e.clientX-r.left-r.width/2)*0.18}px,${(e.clientY-r.top-r.height/2)*0.3}px)`;
    });
    b.addEventListener('pointerleave',()=>{b.style.transform='';});
  });
})();

/* custom cursor */
(function(){
  if(!fine)return;
  const d=document.getElementById('cd'),r=document.getElementById('cr');
  let mx=0,my=0,rx=0,ry=0;
  addEventListener('pointermove',e=>{mx=e.clientX;my=e.clientY;d.style.left=mx+'px';d.style.top=my+'px';});
  (function lerp(){rx+=(mx-rx)*0.16;ry+=(my-ry)*0.16;r.style.left=rx+'px';r.style.top=ry+'px';requestAnimationFrame(lerp);})();
  document.querySelectorAll('a,button,.proj,.skill,input,.status').forEach(el=>{
    el.addEventListener('pointerenter',()=>document.body.classList.add('hovering'));
    el.addEventListener('pointerleave',()=>document.body.classList.remove('hovering'));
  });
})();

/* gold thread scroll progress */
(function(){
  const f=document.getElementById('threadFill');
  function upd(){const h=document.documentElement;const p=h.scrollTop/(h.scrollHeight-h.clientHeight);f.style.height=(p*100)+'%';}
  addEventListener('scroll',upd,{passive:true});upd();
})();

/* reveals + serif counters */
const io=new IntersectionObserver(es=>{es.forEach(e=>{
  if(!e.isIntersecting)return;e.target.classList.add('on');
  e.target.querySelectorAll('.num[data-count]').forEach(n=>{
    if(n.dataset.done)return;n.dataset.done=1;
    const end=parseFloat(n.dataset.count);const unit=n.querySelector('i');const suf=unit?unit.outerHTML:'';
    if(reduced){n.innerHTML=end+suf;return;}
    const t0=performance.now(),dur=1600;
    (function tick(t){const p=Math.min((t-t0)/dur,1),ez=1-Math.pow(1-p,3),v=end*ez;
      n.innerHTML=(end%1?v.toFixed(2):Math.round(v))+suf;
      if(p<1)requestAnimationFrame(tick);})(t0);
  });
  io.unobserve(e.target);
});},{threshold:0.12});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

/* skills */
const groups=["All",...new Set(SKILLS.map(s=>s.group))];
const tabs=document.getElementById('tabs'),grid=document.getElementById('skillgrid');
groups.forEach((g,i)=>{
  const b=document.createElement('button');b.textContent=g;if(i===0)b.classList.add('active');
  b.onclick=()=>{tabs.querySelectorAll('button').forEach(x=>x.classList.remove('active'));b.classList.add('active');
    grid.querySelectorAll('.skill').forEach(el=>el.classList.toggle('hide',g!=='All'&&el.dataset.group!==g));};
  tabs.appendChild(b);
});
SKILLS.forEach(s=>{
  const d=document.createElement('div');d.className='skill';d.dataset.group=s.group;
  d.innerHTML=`<span><b>${s.name}</b><br><i>${s.tag}</i></span><span class="lvl">${'●'.repeat(Math.round(s.level/20))}${'○'.repeat(5-Math.round(s.level/20))}</span>`;
  grid.appendChild(d);
});

/* hidden terminal — press T or click the status dot */
(function(){
  const veil=document.getElementById('veil'),body=document.getElementById('tbody'),input=document.getElementById('tinput');
  const P='<span class="g">guest@agnay:~$</span> ';
  let booted=false;
  function out(html){const d=document.createElement('div');d.className='t-out';d.innerHTML=html;body.appendChild(d);body.scrollTop=body.scrollHeight;}
  const CMDS={
    help:()=>out(`<span class="g">commands:</span> whoami · thesis · projects · skills · contact · scan · clear · exit`),
    whoami:()=>out(`<span class="g">AGNAY KRISHNA BIJU</span> — cybersecurity & AI researcher, Riga LV.
BSc Information Systems, RNU — <span class="ok">degree complete, 2026</span>.
Co-founder & technical lead @ TaraAI (ResellOS).`),
    thesis:()=>out(`LLMs in Vulnerability Analysis & Incident Response:
> 11M+ HDFS lines · baseline <span class="ok">93.58% F1 / 99.61% acc</span>
> Claude Sonnet 4.6 + Llama 3.1 8B · 3 prompt strategies
> 20% hallucination rate · truncation collapsed F1 53.33% → 0%
verdict: classical ML still wins on structured logs. for now.`),
    projects:()=>out(`taraai-resellos/ (flagship) · restaurant-site/ · 360-tour/ · kidcafebot/ · linux-audit/`),
    skills:()=>out(SKILLS.map(s=>`  ${s.group.padEnd(14,' ')} ${s.name}`).join('\n')),
    contact:()=>out(`email: bagnaykrishna@gmail.com · github: AgnayKrishna · +371 26 697 412`),
    scan:()=>{out('scanning visitor…');setTimeout(()=>out('<span class="ok">verdict: NOT_AN_ANOMALY (0.9958) — welcome, human.</span>'),700);},
    clear:()=>{body.innerHTML='';},
    exit:()=>close(),
    sudo:()=>out('nice try. this incident will be reported to absolutely no one.'),
  };
  function open(){
    veil.classList.add('open');input.focus();
    if(!booted){booted=true;out('<span class="ok">you found the hidden shell.</span> type <span class="g">help</span>.');}
  }
  function close(){veil.classList.remove('open');}
  document.getElementById('statusDot').addEventListener('click',open);
  document.getElementById('tclose').addEventListener('click',close);
  addEventListener('keydown',e=>{
    if(e.key==='Escape')close();
    if((e.key==='t'||e.key==='T')&&!veil.classList.contains('open')&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName))open();
  });
  veil.addEventListener('click',e=>{if(e.target===veil)close();});
  input.addEventListener('keydown',e=>{
    if(e.key!=='Enter')return;
    const raw=input.value.trim();input.value='';if(!raw)return;
    out(P+raw);
    const cmd=raw.toLowerCase().split(' ')[0];
    (CMDS[cmd]||(()=>out(`command not found: ${cmd} — try help`)))();
  });
})();
</script>
</body>
